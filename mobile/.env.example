# Use the real API, or point this at the mock server while developing.
EXPO_PUBLIC_SEAT_API_URL=https://v1.nitj.ac.in/erp/library_seating/api.php?action=get-seats

# How often the foreground app polls the seat API (minimum 1000).
EXPO_PUBLIC_POLL_INTERVAL_MS=5000

# Public URL of the push relay (no trailing slash).
EXPO_PUBLIC_PUSH_RELAY_URL=https://your-relay.example.com
